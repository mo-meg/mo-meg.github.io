# Public URL of the deployed site (used for canonical + Open Graph tags). Must end with "/".
VITE_SITE_URL=https://mmm-megahed.github.io/
# Base path. "/" for a user site or custom domain, "/<repo>/" for a project site.
VITE_BASE_PATH=/
# Backend URL of the RAG assistant (no trailing slash). Leave empty to hide the chat widget.
VITE_CHAT_API_URL=
# Link to this portfolio's source repository (shown on the "Portfolio AI Assistant" case study).
VITE_REPO_URL=

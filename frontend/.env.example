# Public URL of the deployed site (used for canonical + Open Graph tags). Must end with "/".
VITE_SITE_URL=https://mmm-megahed.github.io/
# Base path. "/" for a user site or custom domain, "/<repo>/" for a project site.
VITE_BASE_PATH=/
# Q&A drafts: shown in `npm run dev` by default, never in production builds unless set to true.
# QA_INCLUDE_DRAFTS=false
# Link to this portfolio's source repository (shown on the "Portfolio Assistant" case study).
VITE_REPO_URL=

# ---------------------------------------------------------------------------
# Portfolio AI assistant — backend configuration. Copy to .env and fill in.
# NEVER commit .env or real keys.
# ---------------------------------------------------------------------------
# development | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Gemini (https://aistudio.google.com/apikey)
# gemini | fake (fake = offline stand-ins, dev/tests only)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# must match the database column; changing it requires a fresh DB + reindex
EMBEDDING_DIM=768
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=1024
# optional: MINIMAL | LOW | MEDIUM | HIGH (if the model supports it)
GEMINI_THINKING_LEVEL=
GEMINI_TIMEOUT_SECONDS=30

# PostgreSQL with the pgvector extension
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
AUTO_MIGRATE=true

# Ingestion
KNOWLEDGE_DIR=../knowledge
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# optional, raises GitHub API rate limits for README imports
GITHUB_TOKEN=

# Retrieval
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=20
# cosine similarity gate; tune with `python -m app.evaluation --retrieval-only`
RETRIEVAL_MIN_SCORE=0.40

# Conversations
HISTORY_TURNS=6
SESSION_TTL_MINUTES=30
MAX_MESSAGE_CHARS=1000

# Abuse protection
# production: https://mmm-megahed.github.io
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=80
DAILY_REQUEST_BUDGET=1500
# true only behind a proxy/load balancer that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BYTES=16384

# Observability
METRICS_ENABLED=true
# set in production to protect /metrics
METRICS_TOKEN=
